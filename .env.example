# Single configuration file: copy this to .env (never commit real secrets).
# Process environment variables take precedence. Restart services after changes.
# npm run setup generates a local password and fills both database fields.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://applykit:CHANGE_ME@127.0.0.1:54329/applykit
BACKEND_PORT=3333

# Choose one provider: codex | claude | gemini | ollama | compatible.
# Only the selected provider needs to be configured.
CV_PROVIDER=codex
CV_CONCURRENCY=1

# Codex CLI: included in Docker; install for native development. No API key is required here.
# Use a command on PATH or an absolute executable path.
CODEX_EXECUTABLE=codex
# Empty uses the CLI default model.
CODEX_MODEL=

# Claude Code CLI: install a supported version and sign in. See config/CLAUDE.md.
CLAUDE_EXECUTABLE=claude
CLAUDE_MODEL=

# Gemini native API: writer and reviewer keys may be identical.
# Keys in the same Google project share that project's quota.
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY_WRITER=
GEMINI_API_KEY_REVIEWER=

# Ollama: run the service and pull both selected models before generating.
# Empty: localhost in native development; host.docker.internal in Docker.
# The host Ollama server must listen on an address reachable by Docker.
OLLAMA_HOST=
OLLAMA_MODEL_WRITER=qwen3.5:9b
OLLAMA_MODEL_REVIEWER=qwen3.5:9b

# OpenAI-compatible Chat Completions API: enter the FULL endpoint URL.
# Native Gemini/Anthropic APIs require their own adapter, not just a different URL.
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional role keys override the shared LLM_API_KEY.
LLM_API_KEY_WRITER=
LLM_API_KEY_REVIEWER=
# json_object | json_schema | none; see docs/PROVIDERS.md.
LLM_RESPONSE_FORMAT=json_object

# Optional Telegram bot: leave both empty for browser-only use.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Docker: set to telegram to start the optional bot with compose up.
COMPOSE_PROFILES=
