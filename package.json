{
  "name": "applykit",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "build": "node scripts/tasks.mjs build",
    "test": "node scripts/tasks.mjs test",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/tasks.mjs check",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "db:up": "docker compose --env-file .env up -d postgres",
    "db:stop": "docker compose --env-file .env stop postgres",
    "test:setup": "node --test scripts/configure.test.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "configure": "node scripts/configure.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "license": "MIT"
}
